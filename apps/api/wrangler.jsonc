{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cke-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  // Better Auth and pg need Node.js APIs (architecture.md 12.2).
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // The database, through Hyperdrive (architecture.md 14.2). Locally it points at the Docker
  // database. The id is replaced with the real Hyperdrive id when the API is deployed.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "93b9a7dd2ebc4d59ab0429bef37117bf",
      "localConnectionString": "postgres://cke:cke-local-only@127.0.0.1:5432/cke",
    },
  ],
  // Image files (architecture.md 8.2). Locally, wrangler keeps the bucket in .wrangler/state.
  // Photos (8.1) in Workers KV: free with no card, unlike R2 (owner decision, 17 November 2026).
  "kv_namespaces": [{ "binding": "MEDIA", "id": "2ec82bb08db345b48fffc7245b74b365" }],
  // Reset demo data (MGR-29): the repository whose GitHub Actions run the reset once deployed.
  "vars": { "GITHUB_REPO": "ARMSTRONG-AISOSA/casual-kitchen-express" },
  // Sign-in rate limiting (architecture.md 12.2) and the live connection every app keeps open
  // (LiveHub, architecture.md 10). The free plan only has SQLite-backed classes.
  "durable_objects": {
    "bindings": [
      { "name": "AUTH_RATE_LIMITER", "class_name": "AuthRateLimiter" },
      { "name": "LIVE_HUB", "class_name": "LiveHub" },
      // The live simulator's clock for practice orders (architecture.md 18.4).
      { "name": "DEMO_SIM", "class_name": "DemoSim" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AuthRateLimiter"] },
    { "tag": "v2", "new_sqlite_classes": ["LiveHub"] },
    { "tag": "v3", "new_sqlite_classes": ["DemoSim"] },
  ],
  // BETTER_AUTH_SECRET is a secret: in .dev.vars on the laptop, and set with
  // `wrangler secret put BETTER_AUTH_SECRET` on the deployed Worker. Never in this file.
}
