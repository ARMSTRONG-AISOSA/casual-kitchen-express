{
  "name": "@cke/api",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types --include-runtime=false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed-base": "tsx scripts/seed-base.ts",
    "dev:lan": "wrangler dev --ip 0.0.0.0 --port 8787",
    "db:seed-media": "tsx scripts/seed-media.ts",
    "db:seed-people": "tsx scripts/seed-people.ts",
    "db:seed-history": "tsx scripts/seed-history.ts"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.14",
    "@cke/types": "*",
    "@cke/validation": "*",
    "@hono/zod-validator": "0.9.1",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.10",
    "@cloudflare/workers-types": "5.20261028.1",
    "@faker-js/faker": "10.6.0",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "vitest": "5.0.5",
    "wrangler": "4.155.0"
  }
}
