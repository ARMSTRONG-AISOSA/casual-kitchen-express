# Copy to .env (not committed). The API's address, as the phone sees it. Leave it out to use demo
# data only. Start the API with `npm run dev:lan --workspace @cke/api`.
# Google sign-in only returns to http://localhost, so forward the tablet's localhost to the laptop
# with `adb reverse tcp:8787 tcp:8787` (again after each adb reconnect) and use:
EXPO_PUBLIC_API_URL=http://localhost:8787
# Without Google sign-in, the laptop's network address works too, e.g. http://192.168.0.154:8787
