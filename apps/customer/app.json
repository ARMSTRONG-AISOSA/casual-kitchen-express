{
  "expo": {
    "name": "CKE",
    "slug": "cke-customer",
    "scheme": "cke-customer",
    "version": "1.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "../../brand/cke-logo-package/app-icon/cke-app-icon-1024.png",
    "android": {
      "package": "com.armstrongaisosa.casualkitchenexpress.customer",
      "adaptiveIcon": {
        "foregroundImage": "../../brand/cke-logo-package/app-icon/cke-app-icon-maskable-512.png",
        "backgroundColor": "#C83F2D"
      },
      "permissions": ["android.permission.RECORD_AUDIO"],
      "googleServicesFile": "../../google-services.json",
      "versionCode": 3
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      "expo-status-bar",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "CKE uses your photos to add a profile picture.",
          "cameraPermission": "CKE uses the camera to take a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "../../brand/cke-logo-package/logo/png/cke-icon-mono-charcoal.png",
          "color": "#C83F2D"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "CKE uses your location once, when you tap Use my current location, to place your delivery pin.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "../../tools/expo-plugins/with-android-architectures.js",
      "@maplibre/maplibre-react-native",
      [
        "../../tools/expo-plugins/with-release-signing.js",
        {
          "app": "customer"
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0638fb66-9d15-47e1-b446-ff440d9e59fa"
      }
    },
    "owner": "armstrong-aisosas-team"
  }
}
