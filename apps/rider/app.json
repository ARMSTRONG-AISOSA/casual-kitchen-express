{
  "expo": {
    "name": "CKE Rider",
    "slug": "cke-rider",
    "scheme": "cke-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "../../brand/cke-logo-package/app-icon/cke-app-icon-1024.png",
    "android": {
      "package": "com.armstrongaisosa.casualkitchenexpress.rider",
      "adaptiveIcon": {
        "foregroundImage": "../../brand/cke-logo-package/app-icon/cke-app-icon-maskable-512.png",
        "backgroundColor": "#C83F2D"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      "expo-status-bar",
      "expo-splash-screen",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationWhenInUsePermission": "CKE shares your location with your customer while their order is on the way.",
          "locationAlwaysAndWhenInUsePermission": "CKE uses your location to tell your customer when you’re about to arrive, even while you use your navigation app."
        }
      ],
      "../../tools/expo-plugins/with-android-architectures.js"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "15cb2c05-3f99-46e1-bc50-c89585f0bd0b"
      }
    },
    "owner": "armstrong-aisosas-team"
  }
}
