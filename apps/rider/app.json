{
  "expo": {
    "name": "CKE Rider",
    "slug": "cke-rider",
    "scheme": "cke-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "../../brand/cke-logo-package/app-icon/cke-app-icon-1024.png",
    "android": {
      "package": "com.armstrongaisosa.casualkitchenexpress.rider",
      "adaptiveIcon": {
        "foregroundImage": "../../brand/cke-logo-package/app-icon/cke-app-icon-maskable-512.png",
        "backgroundColor": "#C83F2D"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      "expo-status-bar",
      "expo-splash-screen",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationWhenInUsePermission": "CKE shares your location with your customer while their order is on the way.",
          "locationAlwaysAndWhenInUsePermission": "CKE uses your location to tell your customer when you’re about to arrive, even while you use your navigation app."
        }
      ],
      "../../tools/expo-plugins/with-android-architectures.js"
    ]
  }
}
