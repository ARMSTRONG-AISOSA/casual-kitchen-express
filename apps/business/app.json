{
  "expo": {
    "name": "CKE Kitchen",
    "slug": "cke-business",
    "scheme": "cke-business",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "../../brand/cke-logo-package/app-icon/cke-app-icon-1024.png",
    "android": {
      "package": "com.armstrongaisosa.casualkitchenexpress.business",
      "adaptiveIcon": {
        "foregroundImage": "../../brand/cke-logo-package/app-icon/cke-app-icon-maskable-512.png",
        "backgroundColor": "#C83F2D"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      "expo-status-bar",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "CKE Kitchen uses your photos to add pictures of dishes and staff.",
          "cameraPermission": "CKE Kitchen uses the camera to take pictures of dishes and staff."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "../../brand/cke-logo-package/logo/png/cke-icon-mono-charcoal.png",
          "color": "#C83F2D",
          "sounds": ["./assets/sounds/cke_alert.wav", "./assets/sounds/cke_chime.wav"]
        }
      ],
      "../../tools/expo-plugins/with-android-architectures.js"
    ]
  }
}
